# Database
DATABASE_URL=postgresql://jobhunter:jobhunter@localhost:5432/jobhunter

# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
LOG_LEVEL=info

# Local demo user (created by seed)
DEFAULT_USER_EMAIL=demo@jobhunter.local

# File uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./storage/uploads

# AI — Ollama is the default local provider. OpenAI/Gemini are optional.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_PROVIDER=ollama

# SMTP — leave empty to disable sending. Never required for local browsing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# Optional Gmail / Outlook presets (still SMTP; app passwords, not OAuth)
SMTP_PROVIDER=smtp
# smtp | gmail | outlook

# Scraping
HTTP_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=2
SCRAPE_MAX_JOBS_PER_SOURCE=50
